{
  "name": "toolbelt",
  "version": "0.1.0",
  "description": "Useful tools for TypeScript and JavaScript projects",
  "keywords": [],
  "homepage": "https://github.com/williamthorsen/toolbelt#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/toolbelt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/toolbelt.git"
  },
  "license": "UNLICENSED",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "audit": "pnpm run audit:prod && pnpm run audit:dev",
    "audit:dev": "pnpm audit --dev",
    "audit:prod": "pnpm audit --audit-level=high --prod",
    "check": "pnpm run typecheck && pnpm run lint && pnpm test:coverage && pnpm run audit",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint --fix .",
    "ncu": "pnpm --include-workspace-root --recursive --workspace-concurrency=1 exec ncu",
    "outdated": "pnpm outdated --compatible --recursive",
    "outdated:latest": "pnpm outdated --recursive",
    "preinstall": "npx only-allow pnpm",
    "test": "pnpm vitest",
    "test:coverage": "pnpm vitest --coverage",
    "test:watch": "pnpm vitest --watch",
    "typecheck": "pnpm run --recursive typecheck",
    "typecheck:root": "tsc --noEmit",
    "update": "pnpm update --recursive",
    "update:latest": "pnpm update --latest --recursive"
  },
  "devDependencies": {
    "@types/node": "22.15.17",
    "@vitest/coverage-v8": "3.1.3",
    "@vitest/eslint-plugin": "1.1.44",
    "@williamthorsen/eslint-config-typescript": "5.4.0",
    "@williamthorsen/strict-lint": "5.3.0",
    "eslint": "9.26.0",
    "eslint-plugin-import": "2.31.0",
    "prettier": "3.5.3",
    "rimraf": "6.0.1",
    "tsx": "4.19.4",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite-tsconfig-paths": "5.1.4",
    "vitest": "3.1.3"
  },
  "packageManager": "pnpm@10.11.0"
}
