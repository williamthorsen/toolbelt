  "dependencies": {
    "@williamthorsen/toolbelt.objects": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
