{
  "name": "@williamthorsen/toolbelt.text-file-store",
  "version": "0.1.0",
  "description": "A store of named text files, with HTTP and Web Storage backends",
  "keywords": [
    "esm",
    "http",
    "text-files",
    "toolbelt",
    "typescript",
    "web-storage"
  ],
  "homepage": "https://github.com/williamthorsen/toolbelt/tree/main/packages/text-file-store#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/toolbelt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/toolbelt.git",
    "directory": "packages/text-file-store"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/4-release/index.js"
    },
    "./candidate": {
      "import": "./dist/esm/3-candidate/index.js"
    },
    "./draft": {
      "import": "./dist/esm/2-draft/index.js"
    },
    "./proposed": {
      "import": "./dist/esm/1-proposed/index.js"
    }
  },
  "files": [
