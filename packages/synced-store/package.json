{
  "name": "@williamthorsen/toolbelt.synced-store",
  "version": "0.2.0",
  "description": "A store that works offline and converges across devices, over ports that the consumer implements",
  "keywords": [
    "esm",
    "offline",
    "sync",
    "toolbelt",
    "typescript"
  ],
  "homepage": "https://github.com/williamthorsen/toolbelt/tree/main/packages/synced-store#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/toolbelt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/toolbelt.git",
    "directory": "packages/synced-store"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/4-release/index.js"
    },
    "./candidate": {
      "import": "./dist/esm/3-candidate/index.js"
    },
    "./draft": {
      "import": "./dist/esm/2-draft/index.js"
    },
    "./proposed": {
      "import": "./dist/esm/1-proposed/index.js"
    }
  },
  "files": [
