    "cssnano": "^5.1.15",
    "esbuild": "^0.17.11",
    "eslint": "8.36.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.21",
    "postcss-load-config": "^4.0.1",
    "rollup": "^3.19.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "svelte": "^3.56.0",
    "svelte-check": "^3.1.2",
    "svelte-preprocess": "^5.0.1",
