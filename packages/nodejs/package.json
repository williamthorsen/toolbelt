{
  "name": "@williamthorsen/toolbelt.nodejs",
  "version": "3.3.0",
  "description": "Utilities for inspecting Node.js runtimes and toolchains, and for pruning node_modules directories",
  "keywords": [
    "cli",
    "esm",
    "node_modules",
    "nodejs",
    "runtime",
    "toolbelt",
    "toolchain",
    "typescript",
    "utilities"
  ],
  "homepage": "https://github.com/williamthorsen/toolbelt/tree/main/packages/nodejs#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/toolbelt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/toolbelt.git",
    "directory": "packages/nodejs"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/4-release/index.js"
    },
    "./candidate": {
      "import": "./dist/esm/3-candidate/index.js"
    },
    "./draft": {
      "import": "./dist/esm/2-draft/index.js"
    },
    "./proposed": {
      "import": "./dist/esm/1-proposed/index.js"
    }
  },
  "bin": {
    "tb-node": "./bin/tb-node.js"
  },
  "files": [
    "bin/*",
    "CHANGELOG.md",
    "dist/*"
  ],
  "scripts": {
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.cli": "workspace:*",
    "@williamthorsen/toolbelt.numbers": "workspace:*"
  },
  "devDependencies": {
    "@williamthorsen/toolbelt.testing": "workspace:*"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
