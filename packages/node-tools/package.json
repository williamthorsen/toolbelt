  "type": "module",
  "main": "index.js",
  "scripts": {
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:coverage",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint --fix .",
    "test": "pnpm vitest --config=vitest.standalone.config.ts",
    "test:coverage": "pnpm vitest --config=vitest.standalone.config.ts --coverage",
    "test:integration": "pnpm vitest --config=vitest.integration.config.ts",
    "test:watch": "pnpm vitest --config=vitest.standalone.config.ts --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.0.4"
  }
}
