{
  "name": "@williamthorsen/toolbelt.strings",
  "version": "7.0.0",
  "description": "String-handling utilities",
  "keywords": [
    "case-conversion",
    "esm",
    "hash",
    "pluralize",
    "slugify",
    "string",
    "toolbelt",
    "typescript",
    "utilities"
  ],
  "homepage": "https://github.com/williamthorsen/toolbelt/tree/main/packages/strings#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/toolbelt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/toolbelt.git",
    "directory": "packages/strings"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/4-release/index.js"
    },
    "./candidate": {
      "import": "./dist/esm/3-candidate/index.js"
    },
    "./draft": {
      "import": "./dist/esm/2-draft/index.js"
    },
    "./proposed": {
      "import": "./dist/esm/1-proposed/index.js"
    }
  },
  "files": [
    ".readyup/kits/*.js",
    ".readyup/manifest.json",
    "dist/*",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepublishOnly": "rdy compile && nmr build"
  },
  "dependencies": {
    "@williamthorsen/toolbelt.arrays": "workspace:*",
    "@williamthorsen/toolbelt.numbers": "workspace:*",
    "@williamthorsen/toolbelt.sets": "workspace:*"
  },
  "devDependencies": {
    "@sindresorhus/is": "catalog:",
    "@williamthorsen/toolbelt.adoption": "workspace:*",
    "@williamthorsen/toolbelt.testing": "workspace:*",
    "esbuild": "catalog:",
    "readyup": "catalog:"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
