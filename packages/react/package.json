{
  "name": "react",
  "version": "0.1.0",
  "private": true,
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "type": "module",
  "scripts": {
    "build": "pnpm vite build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run test:run",
    "dev": "pnpm vite --host",
    "lint": "pnpm eslint .",
    "lint:fix": "pnpm eslint . --fix",
    "preview": "pnpm vite preview",
    "test": "pnpm vitest --watch",
    "test:coverage": "pnpm vitest --coverage",
    "test:run": "pnpm vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.28",
    "@types/react-dom": "^18.0.11",
    "@vitejs/plugin-react": "^3.1.0",
    "autoprefixer": "^10.4.14",
    "cssnano": "^5.1.15",
    "eslint-plugin-react": "^7.32.2",
    "postcss": "^8.4.21",
    "tailwindcss": "^3.2.7",
    "typescript": "^4.9.5",
    "vite": "^4.1.4"
  }
}
