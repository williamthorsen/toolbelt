{
  "name": "@williamthorsen/toolbelt.llm",
  "version": "0.5.0",
  "description": "Runs an LLM job in the page or at an operator's endpoint, on a credential of the user's or the operator's.",
  "keywords": [
    "esm",
    "llm",
    "toolbelt",
    "typescript"
  ],
  "homepage": "https://github.com/williamthorsen/toolbelt/tree/main/packages/llm#readme",
  "bugs": {
    "url": "https://github.com/williamthorsen/toolbelt/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/williamthorsen/toolbelt.git",
    "directory": "packages/llm"
  },
  "license": "ISC",
  "author": "William Thorsen <william@thorsen.dev> (https://github.com/williamthorsen)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/esm/4-release/index.js"
    },
    "./candidate": {
      "import": "./dist/esm/3-candidate/index.js"
    },
    "./draft": {
      "import": "./dist/esm/2-draft/index.js"
    },
    "./proposed": {
      "import": "./dist/esm/1-proposed/index.js"
    }
  },
  "files": [
    "dist/*",
    "CHANGELOG.md",
    ".meta/changelog.json"
  ],
  "scripts": {
    "prepublishOnly": "nmr build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.107",
    "@ai-sdk/google": "4.0.124",
    "@ai-sdk/openai": "4.0.122",
    "@ai-sdk/openai-compatible": "3.0.94",
    "@standard-schema/spec": "1.1.0",
    "@williamthorsen/toolbelt.errors": "workspace:*",
    "ai": "7.0.179"
  },
  "devDependencies": {
    "@ai-sdk/provider": "4.0.39",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "zod": "^4.1.8"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
