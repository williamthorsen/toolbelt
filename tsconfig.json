// TSConfig for monorepo root. Packages have their own tsconfig.json files that extend this one.
// Shared options come from @williamthorsen/tsconfig; keep only what the base leaves to consumers.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@williamthorsen/tsconfig/tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "~/*": ["./*"],
    },
    "types": ["node"],
  },
  "include": [
    ".config/**/*.ts",
    "__tests__/",
    "config/",
    "scripts/",
    // Root-level TS files so that the ESLint project service can resolve them.
    "*.ts",
  ],
}
